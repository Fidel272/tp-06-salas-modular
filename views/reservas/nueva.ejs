<section class="seccion-formulario">
    <h2>Reservar una Sala</h2>
    <p class="subtitulo-area">Área: <%= seccion %>
    </p>

    <% if (error) { %>
        <div class="alerta-error" role="alert">
            <p><strong>Error:</strong>
                <%= error %>
            </p>
        </div>
        <% } %>

            <form action="/reservas" method="POST" class="formulario-reserva">
                <div class="campo">
                    <label for="estudiante">Nombre del Estudiante:</label>
                    <input type="text" id="estudiante" name="estudiante" value="<%= valores.estudiante || '' %>"
                        required>
                </div>

                <div class="campo">
                    <label for="email">Correo Electrónico:</label>
                    <input type="email" id="email" name="email" value="<%= valores.email || '' %>" required>
                </div>

                <div class="campo">
                    <label for="sala">Sala:</label>
                    <select id="sala" name="sala" required>
                        <option value="">-- Seleccionar Sala --</option>
                        <% salasPermitidas.forEach(s=> { %>
                            <option value="<%= s %>" <%=valores.sala===s ? 'selected' : '' %>><%= s %>
                            </option>
                            <% }); %>
                    </select>
                </div>

                <div class="campo">
                    <label for="fecha">Fecha:</label>
                    <input type="date" id="fecha" name="fecha" value="<%= valores.fecha || '' %>" required>
                </div>

                <div class="campo">
                    <label for="turno">Turno:</label>
                    <select id="turno" name="turno" required>
                        <option value="">-- Seleccionar Turno --</option>
                        <% turnosPermitidos.forEach(t=> { %>
                            <option value="<%= t %>" <%=valores.turno===t ? 'selected' : '' %>><%= t %>
                            </option>
                            <% }); %>
                    </select>
                </div>

                <div class="campo">
                    <label for="personas">Cantidad de Personas (1-6):</label>
                    <input type="number" id="personas" name="personas" min="1" max="6"
                        value="<%= valores.personas || '' %>" required>
                </div>

                <button type="submit" class="boton boton-primario">Confirmar Reserva</button>
            </form>
</section>